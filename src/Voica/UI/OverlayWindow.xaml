<Window x:Class="Voica.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Voica"
        Title="Voica"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" Focusable="False">
    <Window.Resources>
        <!-- Round capsule buttons, 28×28 with radius 14 — same metrics as the macOS HUD. -->
        <Style x:Key="CapsuleButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="14" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- Tag carries the per-button hover tint (red for cancel, green for stop). -->
                                <Setter TargetName="Bg" Property="Background"
                                        Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- The controls share the window but sit outside the main capsule. -->
    <DockPanel Margin="16" VerticalAlignment="Center">
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,7,0">
            <Button x:Name="SettingsButton" Style="{StaticResource CapsuleButton}" ToolTip="{x:Static l:S.MenuSettings}"
                    AutomationProperties.Name="{x:Static l:S.MenuSettings}" Width="22" Height="22" Background="#E61B1B1F" Margin="0,0,0,2" Click="OnOpenSettings">
                <Button.Tag><SolidColorBrush Color="#FFFFFF" Opacity="0.34" /></Button.Tag>
                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#DDFFFFFF" />
            </Button>
            <Button x:Name="PinButton" Style="{StaticResource CapsuleButton}" Width="22" Height="22" Click="OnTogglePin">
                <Button.Tag><SolidColorBrush Color="#FFFFFF" Opacity="0.34" /></Button.Tag>
                <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#DDFFFFFF" />
            </Button>
        </StackPanel>
        <Border x:Name="Capsule" CornerRadius="22" Padding="12,8" MinHeight="44" VerticalAlignment="Center"
                Background="#E61B1B1F" BorderBrush="#28FFFFFF" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.45" Color="#000000" />
            </Border.Effect>
            <Grid>
            <StackPanel x:Name="IdlePanel" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                <Button Style="{StaticResource CapsuleButton}" Background="#34C759"
                        ToolTip="{x:Static l:S.OverlayStartTip}" Click="OnStart">
                    <Button.Tag><SolidColorBrush Color="#4CD964" /></Button.Tag>
                    <Path Width="14" Height="17" Stretch="Uniform" Fill="White"
                          Data="M12,2 A3,3 0 0 0 9,5 L9,11 A3,3 0 0 0 15,11 L15,5 A3,3 0 0 0 12,2 M6,10 L8,10 A4,4 0 0 0 16,10 L18,10 A6,6 0 0 1 13,15.92 L13,18 L16,18 L16,20 L8,20 L8,18 L11,18 L11,15.92 A6,6 0 0 1 6,10 Z" />
                </Button>
            </StackPanel>

            <!-- recording: cancel (×) · wave · stop (✓) — same order and colors as the macOS HUD:
                 a neutral cancel and a system-green confirm, 10 px apart. -->
            <StackPanel x:Name="RecordingPanel" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="CancelButton" Style="{StaticResource CapsuleButton}" Content="✕"
                        Foreground="#D9FFFFFF" ToolTip="{x:Static l:S.OverlayCancelTip}"
                        Margin="0,0,10,0" Click="OnCancel">
                    <Button.Tag><SolidColorBrush Color="#FFFFFF" Opacity="0.34" /></Button.Tag>
                </Button>
                <Border Width="72" Height="22" Margin="0,0,10,0" VerticalAlignment="Center">
                    <StackPanel x:Name="WavePanel" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Button x:Name="StopButton" Style="{StaticResource CapsuleButton}" Content="✓"
                        Background="#34C759" ToolTip="{x:Static l:S.OverlayStopTip}"
                        Click="OnStop">
                    <Button.Tag><SolidColorBrush Color="#4CD964" /></Button.Tag>
                </Button>
            </StackPanel>

            <!-- transcribing: spinner + caption, buttons gone (spec §4.2) -->
            <StackPanel x:Name="TranscribingPanel" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <Canvas Width="18" Height="18" VerticalAlignment="Center" Margin="4,0,10,0">
                    <Ellipse Width="18" Height="18" Stroke="#33FFFFFF" StrokeThickness="2" />
                    <!-- The arc lives in the Canvas's own coordinates, so the rotation center is the
                         circle center (9,9) — a RenderTransformOrigin here would offset it twice. -->
                    <Path x:Name="Spinner" Stroke="#FFFFFF" StrokeThickness="2" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          Data="M 9,1 A 8,8 0 0 1 17,9">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotation" CenterX="9" CenterY="9" />
                        </Path.RenderTransform>
                    </Path>
                </Canvas>
                <TextBlock Text="{x:Static l:S.OverlayTranscribing}" Foreground="#FFFFFF" FontSize="12"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
            </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</Window>
