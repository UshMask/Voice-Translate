<Window x:Class="Voica.UI.PreviewOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowActivated="False" ShowInTaskbar="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" Focusable="False">
    <Border Margin="16" CornerRadius="18" Padding="14,10" MaxWidth="472"
            Background="#E61B1B1F" BorderBrush="#28FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Direction="270" Opacity="0.45" Color="#000000" />
        </Border.Effect>
        <TextBlock x:Name="PreviewText" Foreground="White" FontSize="14" TextWrapping="Wrap" MaxWidth="440" />
    </Border>
</Window>
