<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{x:Static l:S.SettingsTitle}" Width="900" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource SettingsText}" FontFamily="Segoe UI" FontSize="13" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" x:Class="Voica.UI.SettingsWindow" xmlns:l="clr-namespace:Voica">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="SettingsStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolVisibility" />
            <Style x:Key="InfoDot" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Content" Value="" />
                <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Width" Value="26" />
                <Setter Property="MinHeight" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{StaticResource SettingsMuted}" />
                <Setter Property="AutomationProperties.Name" Value="{x:Static l:S.MoreInfo}" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
                <Setter Property="ToolTipService.ShowDuration" Value="60000" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="16" CornerRadius="22" Background="#1B1B1F" BorderBrush="#424249" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.4" />
        </Border.Effect>
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="22,18,18,18" MouseLeftButtonDown="OnHeaderMouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Voica;component/Resources/voica-app.png" Width="28" Height="28" Margin="0,0,10,0" />
                    <TextBlock Text="Voice Translate" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="" FontFamily="Segoe MDL2 Assets" FontSize="12" Width="34" Height="34" Padding="0" HorizontalAlignment="Right" Click="OnClose" IsCancel="True" ToolTip="{x:Static l:S.BtnClose}" AutomationProperties.Name="{x:Static l:S.BtnClose}" />
            </Grid>
            <Border DockPanel.Dock="Bottom" BorderBrush="#35353B" BorderThickness="0,1,0,0" Padding="24,12">
                <TextBlock Text="{x:Static l:S.SettingsApplyHint}" Style="{StaticResource Hint}" Margin="0" />
            </Border>
            <TabControl SelectionChanged="OnTabChanged" x:Name="Tabs">
                <TabItem Header="{x:Static l:S.TabDictation}" Tag="" AutomationProperties.Name="{x:Static l:S.TabDictation}">
                    <StackPanel TextElement.Foreground="{StaticResource SettingsText}">
                        <TextBlock Text="{x:Static l:S.TabDictation}" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{x:Static l:S.LblDictationMode}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ComboBox x:Name="ModeCombo" HorizontalAlignment="Stretch" SelectionChanged="OnModeChanged" AutomationProperties.Name="{x:Static l:S.LblDictationMode}" />
                                <TextBlock Text="{x:Static l:S.LblHotkey}" FontWeight="SemiBold" Margin="0,14,0,6" />
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox x:Name="KeyCombo" SelectionChanged="OnKeyChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static l:S.LblHotkey}" MinWidth="220" Width="270" />
                                    <Button x:Name="CustomKeyButton" Content="{x:Static l:S.BtnCustom}" Margin="8,0,0,0" Click="OnCustomKey" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock x:Name="CurrentHotkeyText" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource InfoDot}" Click="OnHelpClick" LostKeyboardFocus="OnHelpLostFocus">
                                        <Button.ToolTip>
                                            <ToolTip>
                                                <TextBlock Text="{x:Static l:S.HotkeyHint}" TextWrapping="Wrap" MaxWidth="360" />
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>
                                <DockPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource InfoDot}" Margin="6,0,0,0" Click="OnHelpClick" LostKeyboardFocus="OnHelpLostFocus" DockPanel.Dock="Right">
                                        <Button.ToolTip>
                                            <ToolTip>
                                                <TextBlock Text="{x:Static l:S.DoubleTapHint}" TextWrapping="Wrap" MaxWidth="360" />
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                    <CheckBox x:Name="DoubleTapCheck" Content="{x:Static l:S.ChkDoubleTap}" Margin="0" VerticalAlignment="Center" Checked="OnDoubleTapChanged" Unchecked="OnDoubleTapChanged" />
                                </DockPanel>
                                <TextBlock x:Name="HotkeyLayoutWarning" Visibility="Collapsed" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource SettingsWarning}" Text="{x:Static l:S.HotkeyLayoutWarning}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{x:Static l:S.LblOutput}" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ComboBox x:Name="OutputCombo" HorizontalAlignment="Stretch" SelectionChanged="OnOutputChanged" AutomationProperties.Name="{x:Static l:S.LblOutput}" />
                                <DockPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource InfoDot}" Click="OnHelpClick" LostKeyboardFocus="OnHelpLostFocus" DockPanel.Dock="Right">
                                        <Button.ToolTip>
                                            <ToolTip>
                                                <TextBlock Text="{x:Static l:S.KeepInClipboardHint}" TextWrapping="Wrap" MaxWidth="360" />
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                    <CheckBox x:Name="KeepClipboardCheck" Content="{x:Static l:S.ChkKeepInClipboard}" VerticalAlignment="Center" Checked="OnKeepClipboardChanged" Unchecked="OnKeepClipboardChanged" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
                <TabItem Header="{x:Static l:S.TabRecognition}" Tag="" AutomationProperties.Name="{x:Static l:S.TabRecognition}">
                    <StackPanel TextElement.Foreground="{StaticResource SettingsText}">
                        <TextBlock Text="{x:Static l:S.TabRecognition}" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="RecognitionSetupHint" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource SettingsWarning}" Margin="0,0,0,12" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{x:Static l:S.LblEngine}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <ComboBox x:Name="EngineCombo" HorizontalAlignment="Stretch" SelectionChanged="OnEngineChanged" AutomationProperties.Name="{x:Static l:S.LblEngine}" />
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="ModelStatusText" Grid.Column="0" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                                    <Button x:Name="DownloadModelButton" Grid.Column="1" VerticalAlignment="Center" Content="{x:Static l:S.BtnDownloadModel}" Click="OnDownloadModel" MinWidth="100" Margin="0,0,0,0" />
                                    <Button x:Name="CancelDownloadButton" Grid.Column="1" VerticalAlignment="Center" Content="{x:Static l:S.BtnCancelDownload}" Visibility="Collapsed" Click="OnCancelModelDownload" MinWidth="100" Margin="0,0,0,0" />
                                </Grid>
                                <Button x:Name="SelectLocalModelButton" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,3" Click="OnSelectLocalModel" />
                                <TextBlock x:Name="ModelLocationText" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{StaticResource SettingsMuted}" />
                                <ProgressBar x:Name="ModelProgress" Height="6" Margin="0,6,0,0" Minimum="0" Maximum="100" Visibility="Collapsed" />
                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{x:Static l:S.EngineHint}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" x:Name="CloudRecognitionPanel">
                            <StackPanel>
                                <TextBlock Text="{x:Static l:S.LblApiKey}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <Grid>
                                    <PasswordBox x:Name="KeyBox" VerticalContentAlignment="Center" AutomationProperties.Name="{x:Static l:S.LblApiKey}" />
                                    <TextBox x:Name="KeyBoxVisible" VerticalContentAlignment="Center" Visibility="Collapsed" AutomationProperties.Name="{x:Static l:S.LblApiKey}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox x:Name="ShowKeyCheck" Content="{x:Static l:S.ChkShow}" VerticalAlignment="Center" Margin="0,0,16,0" Checked="OnToggleShowKey" Unchecked="OnToggleShowKey" />
                                    <Button x:Name="ValidateButton" Content="{x:Static l:S.BtnValidate}" Margin="0,0,8,0" Click="OnValidateKey" Style="{StaticResource PrimaryButton}" />
                                    <Button x:Name="SaveKeyButton" Content="{x:Static l:S.BtnSave}" Click="OnSaveKey" Style="{StaticResource PrimaryButton}" />
                                </StackPanel>
                                <TextBlock x:Name="KeyStatusText" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="500" HorizontalAlignment="Left" Foreground="{StaticResource SettingsMuted}" />
                                <TextBlock x:Name="NoKeyHint" Visibility="Collapsed" Margin="0,6,0,0" TextWrapping="Wrap" Text="{x:Static l:S.KeyNoKeyHint}" />
                                <TextBlock x:Name="CloudInactiveHint" Text="{x:Static l:S.GroqTermsKeyHint}" TextWrapping="Wrap" Margin="0,0,0,6" Style="{StaticResource Hint}" />
                                <StackPanel x:Name="CloudRecognitionOptions">
                                    <Separator />
                                    <TextBlock Text="{x:Static l:S.LblCloudSection}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8" />
                                    <TextBlock Text="{x:Static l:S.LblSttModel}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <ComboBox x:Name="SttModelCombo" HorizontalAlignment="Stretch" SelectionChanged="OnSttModelChanged" AutomationProperties.Name="{x:Static l:S.LblSttModel}" />
                                    <TextBlock Text="{x:Static l:S.LblLanguage}" FontWeight="SemiBold" Margin="0,14,0,6" />
                                    <DockPanel>
                                        <Button Style="{StaticResource InfoDot}" Click="OnHelpClick" LostKeyboardFocus="OnHelpLostFocus" DockPanel.Dock="Right">
                                            <Button.ToolTip>
                                                <ToolTip>
                                                    <TextBlock Text="{x:Static l:S.SttHint}" TextWrapping="Wrap" MaxWidth="360" />
                                                </ToolTip>
                                            </Button.ToolTip>
                                        </Button>
                                        <ComboBox x:Name="LanguageCombo" HorizontalAlignment="Stretch" SelectionChanged="OnLanguageChanged" AutomationProperties.Name="{x:Static l:S.LblLanguage}" />
                                    </DockPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
                <TabItem Header="{x:Static l:S.TabProcessing}" Tag="" AutomationProperties.Name="{x:Static l:S.TabProcessing}">
                    <StackPanel TextElement.Foreground="{StaticResource SettingsText}">
                        <TextBlock Text="{x:Static l:S.TabProcessing}" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="PipelineSetupHint" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{StaticResource SettingsWarning}" Margin="0,0,0,12" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,8" TextWrapping="Wrap" Text="{x:Static l:S.PipelineHint}" />
                                <CheckBox x:Name="TranslateCheck" Content="{x:Static l:S.PipelineTranslate}" Margin="0,3" Checked="OnPipelineToggle" Unchecked="OnPipelineToggle" />
                                <CheckBox x:Name="CleanupCheck" Content="{x:Static l:S.PipelineCleanup}" Margin="0,3,0,8" Checked="OnPipelineToggle" Unchecked="OnPipelineToggle" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Visibility="{Binding Visibility, ElementName=PipelineOrderPanel}">
                            <StackPanel>
                                <StackPanel x:Name="PipelineOrderPanel">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsChecked, ElementName=TranslateCheck}" Value="True" />
                                                        <Condition Binding="{Binding IsChecked, ElementName=CleanupCheck}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Text="{x:Static l:S.PipelineOrderLabel}" FontWeight="SemiBold" Margin="0,8,0,2" />
                                    <ComboBox x:Name="PipelineOrderCombo" SelectionChanged="OnPipelineOrderChanged" Margin="0,0,0,8" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static l:S.PipelineOrderLabel}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Visibility="{Binding IsChecked, ElementName=TranslateCheck, Converter={StaticResource BoolVisibility}}">
                            <StackPanel>
                                <StackPanel Visibility="{Binding IsChecked, ElementName=TranslateCheck, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="{x:Static l:S.TranslationSettings}" Style="{StaticResource CardHeading}" />
                                    <TextBlock Text="{x:Static l:S.TranslationProviderLabel}" FontWeight="SemiBold" />
                                    <ComboBox x:Name="TranslationProviderCombo" SelectionChanged="OnProvidersChanged" Margin="0,4,0,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static l:S.TranslationProviderLabel}" />
                                    <TextBlock Text="{x:Static l:S.TranslationModelLabel}" />
                                    <TextBox x:Name="TranslationModelBox" Margin="0,4,0,4" AutomationProperties.Name="{x:Static l:S.TranslationModelLabel}" />
                                    <TextBlock Text="{x:Static l:S.TranslationKeyLabel}" />
                                    <Grid Margin="0,4" Height="36">
                                        <PasswordBox x:Name="TranslationKeyBox" PasswordChanged="OnProviderKeyChanged" VerticalContentAlignment="Center" AutomationProperties.Name="{x:Static l:S.TranslationKeyLabel}" />
                                        <TextBlock x:Name="TranslationKeyMask" Text="••••••••" Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                                    </Grid>
                                    <WrapPanel>
                                        <Button Content="{x:Static l:S.SaveTranslationKey}" Click="OnSaveTranslationKey" Padding="8,3" Margin="0,0,6,4" />
                                        <Button Content="{x:Static l:S.PipelineDeleteKey}" Click="OnDeleteTranslationKey" Padding="8,3" />
                                    </WrapPanel>
                                    <TextBlock x:Name="TranslationKeyStatus" Margin="0,0,0,8" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Visibility="{Binding IsChecked, ElementName=CleanupCheck, Converter={StaticResource BoolVisibility}}">
                            <StackPanel>
                                <StackPanel Visibility="{Binding IsChecked, ElementName=CleanupCheck, Converter={StaticResource BoolVisibility}}">
                                    <TextBlock Text="{x:Static l:S.EditingSettings}" Style="{StaticResource CardHeading}" />
                                    <TextBlock Text="{x:Static l:S.EditingProviderLabel}" FontWeight="SemiBold" />
                                    <ComboBox x:Name="CleanupProviderCombo" SelectionChanged="OnProvidersChanged" Margin="0,4,0,4" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static l:S.EditingProviderLabel}" />
                                    <TextBlock Text="{x:Static l:S.EditingKeyLabel}" />
                                    <Grid Margin="0,4" Height="36">
                                        <PasswordBox x:Name="CleanupKeyBox" PasswordChanged="OnProviderKeyChanged" VerticalContentAlignment="Center" AutomationProperties.Name="{x:Static l:S.EditingKeyLabel}" />
                                        <TextBlock x:Name="CleanupKeyMask" Text="••••••••" Margin="6,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                                    </Grid>
                                    <WrapPanel>
                                        <Button Content="{x:Static l:S.SaveEditingKey}" Click="OnSaveCleanupKey" Padding="8,3" Margin="0,0,6,4" />
                                        <Button Content="{x:Static l:S.PipelineDeleteKey}" Click="OnDeleteCleanupKey" Padding="8,3" />
                                    </WrapPanel>
                                    <TextBlock x:Name="CleanupKeyStatus" Margin="0,0,0,8" />
                                    <TextBlock Text="{x:Static l:S.PipelineModel}" FontWeight="SemiBold" />
                                    <TextBox x:Name="CleanupModelBox" Margin="0,4,0,8" AutomationProperties.Name="{x:Static l:S.PipelineModel}" />
                                    <TextBlock Text="{x:Static l:S.PipelinePrompt}" FontWeight="SemiBold" />
                                    <TextBox x:Name="CleanupPromptBox" VerticalContentAlignment="Top" Margin="0,4,0,5" Height="100" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{x:Static l:S.PipelinePrompt}" />
                                    <WrapPanel Margin="0,0,0,6">
                                        <Button Content="{x:Static l:S.PipelinePresetFix}" Click="OnPresetFix" Margin="0,0,6,4" Padding="8,3" />
                                        <Button Content="{x:Static l:S.PipelinePresetShort}" Click="OnPresetShort" Margin="0,0,6,4" Padding="8,3" />
                                        <Button Content="{x:Static l:S.PipelinePresetFormal}" Click="OnPresetFormal" Margin="0,0,6,4" Padding="8,3" />
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Button Content="{x:Static l:S.PipelineSave}" Click="OnSavePipeline" HorizontalAlignment="Left" Margin="0,0,0,4" Padding="8,3">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsChecked, ElementName=TranslateCheck}" Value="False" />
                                                <Condition Binding="{Binding IsChecked, ElementName=CleanupCheck}" Value="False" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock x:Name="PipelineStatus" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{x:Static l:S.LblCleanup}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6" />
                                <DockPanel>
                                    <Button Style="{StaticResource InfoDot}" Click="OnHelpClick" LostKeyboardFocus="OnHelpLostFocus" DockPanel.Dock="Right">
                                        <Button.ToolTip>
                                            <ToolTip>
                                                <TextBlock Text="{x:Static l:S.FillersHint}" TextWrapping="Wrap" MaxWidth="360" />
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                    <CheckBox x:Name="FillersCheck" Content="{x:Static l:S.ChkFillers}" VerticalAlignment="Center" Checked="OnFillersChanged" Unchecked="OnFillersChanged" />
                                </DockPanel>
                                <DockPanel Margin="0,6,0,0">
                                    <Button Style="{StaticResource InfoDot}" Click="OnHelpClick" LostKeyboardFocus="OnHelpLostFocus" DockPanel.Dock="Right">
                                        <Button.ToolTip>
                                            <ToolTip>
                                                <TextBlock Text="{x:Static l:S.QuotesHint}" TextWrapping="Wrap" MaxWidth="360" />
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                    <CheckBox x:Name="QuotesCheck" Content="{x:Static l:S.ChkQuotes}" VerticalAlignment="Center" Checked="OnQuotesChanged" Unchecked="OnQuotesChanged" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
                <TabItem Header="{x:Static l:S.TabVocabulary}" Tag="" AutomationProperties.Name="{x:Static l:S.TabVocabulary}">
                    <StackPanel TextElement.Foreground="{StaticResource SettingsText}">
                        <TextBlock Text="{x:Static l:S.TabVocabulary}" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="{x:Static l:S.LblVocabulary}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource InfoDot}" Click="OnHelpClick" LostKeyboardFocus="OnHelpLostFocus">
                                        <Button.ToolTip>
                                            <ToolTip>
                                                <TextBlock Text="{x:Static l:S.VocabHint}" TextWrapping="Wrap" MaxWidth="360" />
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                </StackPanel>
                                <TextBlock Text="{x:Static l:S.VocabularyShortHint}" Style="{StaticResource Hint}" />
                                <TextBox x:Name="VocabularyBox" VerticalContentAlignment="Top" Height="140" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="OnVocabularyTextChanged" LostFocus="OnVocabularyChanged" AutomationProperties.Name="{x:Static l:S.LblVocabulary}" />
                                <TextBlock x:Name="VocabCounter" HorizontalAlignment="Right" Margin="0,2,0,0" Foreground="{StaticResource SettingsMuted}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button Style="{StaticResource InfoDot}" Click="OnHelpClick" LostKeyboardFocus="OnHelpLostFocus" DockPanel.Dock="Right">
                                        <Button.ToolTip>
                                            <ToolTip>
                                                <TextBlock Text="{x:Static l:S.TermRulesHint}" TextWrapping="Wrap" MaxWidth="360" />
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                    <CheckBox x:Name="TermRulesCheck" Content="{x:Static l:S.ChkTermRules}" VerticalAlignment="Center" Checked="OnTermRulesChanged" Unchecked="OnTermRulesChanged" />
                                </DockPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <Button Style="{StaticResource InfoDot}" Click="OnHelpClick" LostKeyboardFocus="OnHelpLostFocus" DockPanel.Dock="Right">
                                        <Button.ToolTip>
                                            <ToolTip>
                                                <TextBlock Text="{x:Static l:S.LlmHint}" TextWrapping="Wrap" MaxWidth="360" />
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                    <CheckBox x:Name="LlmCheck" Content="{x:Static l:S.ChkLlm}" VerticalAlignment="Center" Checked="OnLlmChanged" Unchecked="OnLlmChanged" />
                                </DockPanel>
                                <TextBlock x:Name="LlmStatusText" TextWrapping="Wrap" Margin="0,0,0,4" MaxWidth="500" HorizontalAlignment="Left" Foreground="{StaticResource SettingsMuted}" />
                                <StackPanel x:Name="ChatModelPanel" Orientation="Vertical" Margin="0,0,0,6" Visibility="Collapsed">
                                    <TextBlock Text="{x:Static l:S.LblChatModel}" VerticalAlignment="Center" Margin="0,6,0,6" />
                                    <ComboBox x:Name="ChatModelCombo" SelectionChanged="OnChatModelChanged" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Static l:S.LblChatModel}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
                <TabItem Header="{x:Static l:S.TabAppearance}" Tag="" AutomationProperties.Name="{x:Static l:S.TabAppearance}">
                    <StackPanel TextElement.Foreground="{StaticResource SettingsText}">
                        <TextBlock Text="{x:Static l:S.TabAppearance}" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{x:Static l:S.IslandHeading}" Style="{StaticResource CardHeading}" />
                                <DockPanel Margin="0,12,0,0">
                                    <Button Style="{StaticResource InfoDot}" Click="OnHelpClick" LostKeyboardFocus="OnHelpLostFocus" DockPanel.Dock="Right">
                                        <Button.ToolTip>
                                            <ToolTip>
                                                <TextBlock Text="{x:Static l:S.OverlayHint}" TextWrapping="Wrap" MaxWidth="360" />
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                    <CheckBox x:Name="OverlayCheck" Content="{x:Static l:S.ChkOverlay}" VerticalAlignment="Center" Checked="OnOverlayChanged" Unchecked="OnOverlayChanged" />
                                </DockPanel>
                                <DockPanel Margin="0,8,0,0">
                                    <Button Style="{StaticResource InfoDot}" Click="OnHelpClick" LostKeyboardFocus="OnHelpLostFocus" DockPanel.Dock="Right">
                                        <Button.ToolTip>
                                            <ToolTip>
                                                <TextBlock Text="{x:Static l:S.PersistentOverlayHint}" TextWrapping="Wrap" MaxWidth="360" />
                                            </ToolTip>
                                        </Button.ToolTip>
                                    </Button>
                                    <CheckBox x:Name="PersistentOverlayCheck" Content="{x:Static l:S.ChkPersistentOverlay}" Checked="OnPersistentOverlayChanged" Unchecked="OnPersistentOverlayChanged" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox x:Name="LivePreviewCheck" Content="{x:Static l:S.ChkLivePreview}" Checked="OnLivePreviewChanged" Unchecked="OnLivePreviewChanged" />
                                </StackPanel>
                                <TextBlock Text="{x:Static l:S.LivePreviewHint}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <CheckBox x:Name="NotifyInsertCheck" Content="{x:Static l:S.ChkNotify}" Margin="0,0,0,0" Checked="OnNotifyInsertChanged" Unchecked="OnNotifyInsertChanged" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
                <TabItem Header="{x:Static l:S.TabDataPrivacy}" Tag="" AutomationProperties.Name="{x:Static l:S.TabDataPrivacy}">
                    <StackPanel TextElement.Foreground="{StaticResource SettingsText}">
                        <TextBlock Text="{x:Static l:S.TabDataPrivacy}" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{x:Static l:S.StorageHeading}" Style="{StaticResource CardHeading}" />
                                <CheckBox x:Name="StoreAudioCheck" Content="{x:Static l:S.ChkStoreAudio}" Margin="0,2" Checked="OnStoreAudioChanged" Unchecked="OnStoreAudioChanged" />
                                <TextBlock Text="{x:Static l:S.AudioStorageHint}" Style="{StaticResource Hint}" />
                                <WrapPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="{x:Static l:S.LblRetention}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox x:Name="RetentionBox" Width="60" LostFocus="OnRetentionChanged" AutomationProperties.Name="{x:Static l:S.LblRetention}" />
                                    <TextBlock Text="{x:Static l:S.RetentionSuffix}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{StaticResource SettingsMuted}" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{x:Static l:S.LocalModelHeading}" Style="{StaticResource CardHeading}" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="DeleteModelButton" Content="{x:Static l:S.BtnDeleteModel}" Click="OnDeleteModel" />
                                    <TextBlock x:Name="ModelDiskText" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource SettingsMuted}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{x:Static l:S.ResetHeading}" Style="{StaticResource CardHeading}" />
                                <TextBlock TextWrapping="Wrap" Margin="0,4,0,0" Text="{x:Static l:S.ResetMsg}" Foreground="{StaticResource SettingsMuted}" />
                                <Button Content="{x:Static l:S.BtnResetSettings}" HorizontalAlignment="Left" Click="OnResetSettings" />
                                <Separator />
                                <TextBlock Text="{x:Static l:S.DeleteDataHint}" Style="{StaticResource Hint}" />
                                <Button Content="{x:Static l:S.BtnDeleteAll}" HorizontalAlignment="Left" Foreground="{StaticResource SettingsError}" Click="OnDeleteAllData" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
                <TabItem Header="{x:Static l:S.TabNetwork}" Tag="" AutomationProperties.Name="{x:Static l:S.TabNetwork}">
                    <StackPanel TextElement.Foreground="{StaticResource SettingsText}">
                        <TextBlock Text="{x:Static l:S.TabNetwork}" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{x:Static l:S.LblProxy}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <CheckBox x:Name="SystemProxyCheck" Content="{x:Static l:S.ChkUseSystemProxy}" Margin="0,2" Checked="OnSystemProxyChanged" Unchecked="OnSystemProxyChanged" />
                                <TextBlock x:Name="ProxyRouteText" Margin="0,10,0,0" TextWrapping="Wrap" MaxWidth="500" HorizontalAlignment="Left" Foreground="{StaticResource SettingsMuted}" />
                                <TextBlock TextWrapping="Wrap" Margin="0,12,0,0" MaxWidth="500" HorizontalAlignment="Left" Text="{x:Static l:S.ProxyHint}" Foreground="{StaticResource SettingsMuted}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
                <TabItem Header="{x:Static l:S.TabAbout}" Tag="" AutomationProperties.Name="{x:Static l:S.TabAbout}">
                    <StackPanel TextElement.Foreground="{StaticResource SettingsText}">
                        <TextBlock Text="{x:Static l:S.TabAbout}" Style="{StaticResource SectionTitle}" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="pack://application:,,,/Voica;component/Resources/voica-app.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Voice Translate" FontSize="20" FontWeight="Bold" />
                                        <TextBlock x:Name="AboutVersionText" Foreground="{StaticResource SettingsMuted}" />
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Text="{x:Static l:S.ForkTagline}" />
                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="{x:Static l:S.ForkPrivacy}" Foreground="{StaticResource SettingsMuted}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{x:Static l:S.LblUpdates}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                <StackPanel Orientation="Horizontal">
                                    <Button x:Name="CheckNowButton" Content="{x:Static l:S.BtnCheckNow}" Click="OnCheckUpdatesNow" />
                                    <Button x:Name="DownloadUpdateButton" Margin="8,0,0,0" Visibility="Collapsed" Click="OnOpenUpdatePage" />
                                </StackPanel>
                                <TextBlock x:Name="UpdateStatusText" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="500" HorizontalAlignment="Left" Foreground="{StaticResource SettingsMuted}" />
                                <CheckBox x:Name="CheckUpdatesCheck" Content="{x:Static l:S.ChkCheckUpdates}" Margin="0,10,0,0" Checked="OnCheckUpdatesChanged" Unchecked="OnCheckUpdatesChanged" />
                                <TextBlock Text="{x:Static l:S.ForkUpdatesHint}" Style="{StaticResource Hint}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock>
                                    <Hyperlink NavigateUri="https://github.com/UshMask/Voice-Translate" RequestNavigate="OnNavigate">
                                        <Run Text="{x:Static l:S.BtnGitHub}" />
                                    </Hyperlink>
                                    <Run Text="  ·  " Foreground="Gray" />
                                    <Hyperlink NavigateUri="https://boosty.to/voica" RequestNavigate="OnNavigate">
                                        <Run Text="{x:Static l:S.BtnSupport}" />
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap" Text="{x:Static l:S.SupportHint}" Foreground="{StaticResource SettingsMuted}" />
                                <TextBlock Margin="0,8,0,0" FontSize="11" Text="{x:Static l:S.AboutLicense}" Foreground="{StaticResource SettingsMuted}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </DockPanel>
    </Border>
</Window>
